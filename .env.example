# ==============================================================================
# Rainfall Intelligence Platform (SIH26080) — Environment Template
# ==============================================================================

ENVIRONMENT=production
APP_NAME="Rainfall Intelligence"
APP_SUBTITLE="Regime-Aware Rainfall Forecast Intelligence Platform"
SIH_PROBLEM_CODE=SIH26080

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database Configuration (PostgreSQL on Render/Neon or local SQLite fallback)
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./rainfall_intelligence.db

# Live NWP / Meteorological Data Source API Configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=

# MOSDAC (ISRO Meteorological & Oceanographic Satellite Data Archival Centre)
MOSDAC_USERNAME=your_mosdac_username
MOSDAC_PASSWORD=your_mosdac_password

# CORS Configuration (Allowed origins separated by comma)
CORS_ORIGINS=*

# AI Assistant / Meteorological Chatbot Configuration (Groq Llama-3.3-70B)
GROQ_API_KEY=your_groq_api_key_here
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=groq
LLM_TIMEOUT_SECONDS=25

# Optional Twilio Voice / SMS Alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TEST_PHONE_NUMBER=
